# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Database Warehouse Configuration
DATABASE_URL=sqlite:///./data/anomaly_hub.db

# Audit & Anomaly Detection Thresholds
PRICE_SPIKE_THRESHOLD_PCT=25.0
NEAR_DUPLICATE_DAYS=7
PROCUREMENT_THRESHOLD=3500000.0
